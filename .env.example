PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=echat
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
CLIENT_URLS=http://localhost:8081
# Production example: CLIENT_URLS=https://app.example.com,https://admin.example.com
# Optional: Redis (OTP store, token blacklist, socket adapter). Works without it.
REDIS_URL=redis://localhost:6379
# Comma separated user ids that can use /api/admin
# Set explicitly to the admin phone numbers you trust (comma-separated).
ADMIN_PHONES=
# ADMIN_IDS=1
# Development only: return the OTP in the response when WhatsApp is not linked
OTP_DEV_MODE=true
# WhatsApp OTP delivery (set to false to disable the puppeteer client)
WHATSAPP_ENABLED=true
# Open http://<server>:5000/api/whatsapp/setup to scan the QR (from this machine, or with ?key=<WHATSAPP_SETUP_KEY>)
# WHATSAPP_SETUP_KEY=choose-a-long-random-string
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Voice/video calls (optional TURN relay; without it calls work on the same Wi-Fi / most networks via STUN) ---
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=secret

# --- Optional ---
# SENTRY_DSN=            (then: npm i @sentry/node)
# APP_NAME=Special       (shown on /privacy)
# SUPPORT_EMAIL=you@example.com
# MYMEMORY_EMAIL=you@example.com   (free: raises the translation quota)
